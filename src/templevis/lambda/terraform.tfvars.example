# Terraform Variables Example File
# Copy this to terraform.tfvars and fill in your values

# AWS region for deployment
aws_region = "us-east-1"

# Environment name (dev, staging, prod)
environment = "dev"

# Verified SES email address to send from (must be verified in SES)
from_email = "notifications@temple.org"

# Email address to receive PDFs (must be verified in SES)
receipt_email = "schedule@temple.org"

# Enable virus scanning (requires ClamAV Lambda layer)
virus_scan_enabled = false

# Lambda memory allocation in MB (128-10240)
lambda_memory = 1024

# Lambda timeout in seconds
lambda_timeout = 300

# Maximum pages allowed in PDF
max_pdf_pages = 5
